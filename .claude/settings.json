{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr status:*)",
      "Bash(gh issue:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh repo sync:*)",
      "Bash(gh auth status)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(tar:*)",
      "Bash(unzip:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(echo:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(xargs:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(jq:*)",
      "Bash(pytest:*)",
      "Bash(copier:*)",
      "Bash(cd *)",
      "Bash(PYTHONPYCACHEPREFIX=*:*)",
      "Bash(PYTHONPATH=*:*)",
      "Read(**)",
      "Edit(**)",
      "Glob",
      "Grep",
      "Bash(command -v python3)",
      "Bash(PYTHONPATH=src python3 -m unittest discover -s tests -v)",
      "Bash(PYTHONPATH=src python3 -m unittest discover -s tests)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(mkfs:*)",
      "Bash(dd:*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.ssh/**)",
      "Read(**/credentials*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(.env)",
      "Edit(.env.*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)"
    ],
    "defaultMode": "acceptEdits"
  }
}
